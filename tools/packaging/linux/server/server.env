# Settings for the Koalino server (koalino-daemon and koalino-cli). Readable only by root and the
# koalino group. One NAME=value per line; the variables are listed in the project README's
# Configuration section. Restart the service after a change: sudo systemctl restart koalino-daemon
#
# Without a passphrase, a random key is kept in /var/lib/koalino/keys/encryption.key (owner-only).
# Back up that file, or set a passphrase here before the first start: a passphrase set later does
# not open a database created with the key file.
#NOTE_TAKER_ENCRYPTION_PASSPHRASE=
#
# HTTP API address. Keep it on 127.0.0.1 and reach it through an SSH tunnel.
#NOTE_TAKER_BIND_ADDRESS=127.0.0.1:8080
#
# Name shown to your other devices during pairing.
#NOTE_TAKER_DEVICE_NAME=
#
# Recording language (auto, it, en, ...).
#NOTE_TAKER_WHISPER_LANGUAGE=auto
