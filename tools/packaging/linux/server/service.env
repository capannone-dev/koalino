# Where the koalino-daemon service keeps its data (#191). Read by the systemd units and by
# koalino-cli, so both use the same database and key. The package replaces this file on upgrade:
# put your own settings in /etc/koalino/server.env, which wins.
NOTE_TAKER_DATABASE_PATH=/var/lib/koalino/note_taker.sqlite3
NOTE_TAKER_KEYCHAIN_ENABLED=false
NOTE_TAKER_ENCRYPTION_KEY_DIR=/var/lib/koalino/keys
NOTE_TAKER_LOG_DIR=/var/log/koalino
NOTE_TAKER_REVIEW_CLIP_DIR=/var/lib/koalino/voice_review_clips
NOTE_TAKER_EXPORT_DIR=/var/lib/koalino/exports
