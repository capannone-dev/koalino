<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Device sync (Issue #43): libp2p over TCP/QUIC, and mDNS discovery on the local network,
         which Android filters unless the app holds a multicast lock (see MainActivity). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <!-- App lock (AppLock.kt): the system BiometricPrompt, with the screen lock as fallback. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- The Rust core records the microphone itself (cpal on AAudio); asked at run time. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Meeting photos (Issue #54): the camera plugin asks for CAMERA at run time. A phone
         without a camera can still install the app; it just attaches files. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera.any" android:required="false"
        tools:replace="android:required"/>
    <!-- Background and lock-screen recording (RecordingService.kt, Issue #47). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Keeps the charging job for a waiting after-meeting pass across reboots (#87). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Asks once to exempt Koalino from battery optimisation, so that charging job runs even
         with Power saving on (#87); the owner answers in a system dialog. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <application
        android:label="Koalino"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Efficient mode (#75): apps can only open the vendor's OpenCL library if they declare
             it. Not required, so phones without it install the app and stay on the processor. -->
        <uses-native-library android:name="libOpenCL.so" android:required="false"/>
        <!-- Whisper on the NPU (#75): the downloaded QNN runtime reaches the NPU through the
             vendor's FastRPC library, which apps can open only if they declare it. -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Share to a project (IncomingShares.kt, Issue #85): e-mails from mail apps, PDFs,
                 pictures, Markdown and text. Only content URIs are read. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="message/rfc822"/>
                <data android:mimeType="application/pdf"/>
                <data android:mimeType="image/*"/>
                <data android:mimeType="text/*"/>
            </intent-filter>
            <!-- Pairing invites (PairingLinks.kt, Issue #122): the camera opens the
                 note-taker-invite: link in another device's QR code here. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="note-taker-invite"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Keeps a recording alive in the background and on the lock screen (Issue #47). -->
        <service
            android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone"/>
        <!-- Runs a waiting after-meeting pass while charging, with the app closed (#87). -->
        <service
            android:name=".WaitingPassJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"/>
        <!-- Serves exported logs in cache/shared to the app picked in the share sheet
             (SharedFiles.kt, Issue #46); reachable only through a share's URI grant. -->
        <provider
            android:name=".SharedFileProvider"
            android:authorities="${applicationId}.shared"
            android:exported="false"
            android:grantUriPermissions="true"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Hand a meeting to the owner's own AI app (#114): lets SharedFiles.kt see whether the
             Claude or ChatGPT app is installed. -->
        <package android:name="com.anthropic.claude"/>
        <package android:name="com.openai.chatgpt"/>
    </queries>
</manifest>
