# Rust compiler build artifacts are reproducible and must not be committed.
/target/

# Local SQLite runtime database; it may contain private meeting data.
/note_taker.sqlite3

# Atomic content-addressed attachment transfer staging files.
/.note_taker/files/.transfer-*.tmp

# Web dependencies and build output are installed or generated by npm and Next.js.
/web/node_modules/
/web/.next/
/web/package-lock.json
/web/tsconfig.tsbuildinfo

# Packaged programs and models from tools/cross/package-linux-server.sh.
/dist/

# Browser extension dependencies and build output.
/browser-extension/node_modules/
/browser-extension/dist/
/browser-extension/package-lock.json
