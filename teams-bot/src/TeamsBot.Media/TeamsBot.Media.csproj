<!--
  Adapter between Microsoft Teams (Graph Communications calling SDK + Real-Time Media) and the
  platform-neutral TeamsBot.Core abstractions. It compiles on any OS, but the media platform's
  native libraries only run on 64-bit Windows Server.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TeamsBot.Media</RootNamespace>
    <!-- Microsoft.Skype.Bots.Media ships x64 native code only. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../TeamsBot.Core/TeamsBot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Graph.Communications.Calls.Media" />
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
