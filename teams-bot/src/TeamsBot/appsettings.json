{
  "Urls": "http://localhost:9441",
  "AzureAd": {
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": ""
  },
  "TeamsBot": {
    "WebSocketUrl": "ws://localhost:8765",
    "SharedSecret": "",
    "VideoFps": 1,
    "VideoQuality": 80,
    "ApiKey": "",
    "Calling": {
      "NotificationUrl": "",
      "ServiceFqdn": "",
      "CertificateThumbprint": "",
      "MediaPublicPort": 8445,
      "MediaInternalPort": 8445,
      "MediaPublicIpAddress": "",
      "JoinTimeout": "00:01:30"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Graph.Communications": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}" } }
    ]
  },
  "AllowedHosts": "*"
}
